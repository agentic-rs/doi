{
  "name": "@agentic-rs/doi",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-applet.ts",
    "build:ai": "node scripts/build-applet-ai.ts",
    "simulator:sync": "pnpm test && pnpm test:ai && \"${APELL_BIN:-apell}\" dev --project \"${APELL_PROJECT:-../apell}\" --target \"${APELL_SIMULATOR:-Apell iPhone 16 Pro}\" --install artifacts/doi.apel",
    "test": "pnpm build && vitest run",
    "test:ai": "cargo test --offline --manifest-path crates/doi-ai/Cargo.toml"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=24"
  }
}
